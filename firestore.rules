rules_version = '2';

// Firestore Security Rules for CS2 Portfolio Manager
//
// These rules control who can read/write data. Firebase Auth
// provides the user's identity (request.auth.uid = their steamId).
//
// Firestore rules do NOT cascade: a rule on a document says nothing
// about its subcollections, so each level gets its own match. Anything
// not matched below is denied. Tests: functions/test/rules.emulator.test.js

service cloud.firestore {
  match /databases/{database}/documents {
    // Tokens minted by the old, unverified login flow lack this claim and
    // get no access to cloud data.
    function verifiedUser() {
      return request.auth != null && request.auth.token.steamVerified == true;
    }

    // Server-only collections, written by Cloud Functions (Admin SDK)
    // and denied to every client by omission:
    //   steamLoginSessions — one-time Steam login challenges (TTL-deleted)
    //   priceHistory       — hourly price samples behind the % changes

    // User profiles — users can only read/write their own
    match /users/{steamId} {
      allow read, delete: if verifiedUser() && request.auth.uid == steamId;
      // storageItemNames feeds the server's price watch list, so its size is
      // capped (pricing costs grow with it).
      allow create, update: if verifiedUser() && request.auth.uid == steamId
        && (!('storageItemNames' in request.resource.data)
            || (request.resource.data.storageItemNames is list
                && request.resource.data.storageItemNames.size() <= 5000));
    }

    // Inventories — users can only access their own inventory
    match /inventories/{steamId} {
      allow read, write: if verifiedUser() && request.auth.uid == steamId;

      // The items subcollection needs its own rule (rules don't cascade)
      match /items/{itemId} {
        allow read, write: if verifiedUser() && request.auth.uid == steamId;
      }
    }

    // Prices — shared collection every user reads. Only the scheduled
    // Cloud Function writes it (the Admin SDK bypasses rules), so no client
    // can plant a fake price that other users would see.
    match /prices/{priceId} {
      allow read: if verifiedUser();
      allow write: if false;
    }

    // Server metadata (e.g. priceRefresh.lastRun) — any authenticated
    // user can read; only Cloud Functions (Admin SDK) write it.
    match /meta/{docId} {
      allow read: if verifiedUser();
      allow write: if false;
    }

    // Alerts — users can only manage their own alerts
    match /alerts/{alertId} {
      allow read, delete: if verifiedUser()
        && resource.data.steamId == request.auth.uid;
      allow update: if verifiedUser()
        && resource.data.steamId == request.auth.uid
        && request.resource.data.steamId == request.auth.uid;
      allow create: if verifiedUser()
        && request.resource.data.steamId == request.auth.uid;
    }
  }
}
